    {
      "id": "DF_PAY_01",
      "module": "Payment & Refund",
      "title": "Timezone Drift in Refund Calculations",
      "severity": "High",
      "status": "Closed (Resolved and verified)",
      "relatedTcId": "TC_PAY_02",
      "description": "Time offset logic computes incorrect hours when comparing transaction timestamps on local Windows servers running under UTC+7.",
      "steps": "1. Deploy the test environment on a host using the `Asia/Ho_Chi_Minh` timezone.<br>2. Submit a booking cancellation request exactly 13 hours prior to slot start.<br>3. Inspect the refund percentage.",
      "expected": "Refund rate calculations return 100% (since cancellation occurs $> 12$h before slot).",
      "actual": "Refund rate calculations return 70% (computed difference is skewed to 6 hours due to raw UTC drift).",
      "suggestedFix": "Sử dụng giờ VN thay vì Date.getUTCHours()."
    },
    {
      "id": "DF_PAY_02",
      "module": "Payment & Refund",
      "title": "Missing success field in PayOS Mock Response",
      "severity": "Medium",
      "status": "Closed (Resolved and verified)",
      "relatedTcId": "TC_PAY_01",
      "description": "Checkouts fail with error notifications on checkout redirects.",
      "steps": "1. Trigger checkout links by calling `/api/payments/create`.<br>2. Inspect payment checkout responses.",
      "expected": "Generates a valid payment redirect link.",
      "actual": "Call fails with exception message: `\"Không thể tạo payment PayOS: Unknown error\"`.",
      "suggestedFix": "Bổ sung success: true trong mock."
    }
  ],
