{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./backend/src/*",
        "./frontend/src/*"
      ]
    },
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": [
    "tests/**/*",
    "frontend/tests/**/*",
    "setupTests.ts",
    "setupBackendTests.ts",
    "vitest.config.ts",
    "vitest.workspace.ts"
  ]
}
