{
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:dashboard": "npx tsx scripts/generate-dashboard-data.ts",
    "dashboard:build": "npm run --prefix test-dashboard-src build",
    "dashboard": "node scripts/serve-dashboard.js",
    "dashboard:dev": "npm run --prefix test-dashboard-src dev",
    "report": "npm run test && npm run test:coverage && npm run test:dashboard"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^12.6.0",
    "next": "^16.2.9",
    "nodemailer": "^9.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^3.0.7",
    "jsdom": "^26.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.7"
  }
}
